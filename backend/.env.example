# ============================================================
# Aarogya Clinic Voice Receptionist — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ── Supabase / Postgres (source of truth for scheduling) ─────
# Use the Session Pooler connection string (IPv4) from
# Supabase → Project Settings → Database → Connect.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# ── Cliniko PMS (system-of-record + write-back target) ───────
# Format: <base64-ish-key>-<shard>, e.g. ...-au5. Shard determines the API host.
CLINIKO_API_KEY=
# Contact email Cliniko requires in the User-Agent header on every request.
CONTACT_EMAIL=

# ── Bolna (voice platform) ────────────────────────────────────
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=https://api.bolna.ai
# The phone number attached to the Bolna agent, used as caller ID for outbound calls.
BOLNA_FROM_NUMBER=

# Shared secret Bolna must send as the X-Tool-Secret header on every /tools/* and
# /webhooks/* call. Generate one, e.g.: python -c "import secrets;print(secrets.token_urlsafe(32))"
TOOL_WEBHOOK_SECRET=

# Public HTTPS URL of this backend (ngrok tunnel or hosted deployment) that Bolna's
# tool calls and end-of-call webhook point at. Referenced when generating bolna/tools.resolved.json.
BASE_URL=

# Optional keep-warm pinger. On Render, set KEEP_WARM_URL to the deployed backend URL
# (usually the same as BASE_URL). The worker pings KEEP_WARM_PATH every interval.
KEEP_WARM_URL=
KEEP_WARM_PATH=/health
KEEP_WARM_INTERVAL_SECONDS=300

# ── Eval harness LLM (offline scenario runner only — NOT the live voice agent) ──
# OpenAI-compatible endpoint. Defaults to NVIDIA NIM if unset.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_API_KEY=
# Alternative: point LLM_API_KEY/LLM_BASE_URL/LLM_MODEL at OpenAI or any OpenAI-compatible provider.
# LLM_API_KEY=
# OPENAI_API_KEY=

# ── Optional: force the Cliniko write-back path to fail (for testing the retry/failure flow) ──
# PMS_FAIL_MODE=1
