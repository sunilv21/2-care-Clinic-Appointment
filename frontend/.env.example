# Aarogya Clinic dashboard — frontend environment template.
# Copy to `.env` for local overrides, or set as a Vercel project environment variable.

# Public URL of the deployed backend (Railway/Render/etc.). Required ONLY when this dashboard is
# deployed separately from the backend (e.g. on Vercel). Leave unset for local dev (Vite's dev
# proxy handles it — see vite.config.ts) or for a single-host deployment where the backend itself
# serves this build.
VITE_API_BASE_URL=https://your-backend.up.railway.app
